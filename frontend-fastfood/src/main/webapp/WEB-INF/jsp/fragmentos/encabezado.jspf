<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%-- Barra superior común. Muestra el usuario solo si hay sesión
     (en el login, la barra aparece sin datos de usuario).

     Menú hamburguesa sin JavaScript (solo en el celular):
     - el botón ☰ es el <label> de una casilla de verificación oculta;
       tocarlo marca o desmarca la casilla;
     - el CSS muestra el menú solo cuando está marcada
       (.menu-check:checked ~ ...);
     - el fondo oscuro es otro <label> de la misma casilla:
       tocar afuera del menú lo cierra. --%>
<header class="encabezado">
    <a class="marca" href="${pageContext.request.contextPath}/inicio">FastFood</a>

    <c:if test="${not empty sessionScope.usuario}">
        <input type="checkbox" id="menu-abierto" class="menu-check">
        <label for="menu-abierto" class="hamburguesa" aria-label="Abrir o cerrar el menú"></label>

        <div class="usuario">
            <span class="quien">
                <span class="nombre"><c:out value="${sessionScope.usuario.nombre} ${sessionScope.usuario.apellido}"/></span>
                <span class="rol"><c:out value="${sessionScope.usuario.rol}"/></span>
            </span>
            <a href="${pageContext.request.contextPath}/inicio">Inicio</a>
            <form method="post" action="${pageContext.request.contextPath}/logout">
                <button type="submit">Cerrar sesión</button>
            </form>
        </div>

        <%-- Fondo oscuro detrás del menú abierto: tocarlo cierra el menú --%>
        <label for="menu-abierto" class="fondo-menu" aria-hidden="true"></label>
    </c:if>
</header>