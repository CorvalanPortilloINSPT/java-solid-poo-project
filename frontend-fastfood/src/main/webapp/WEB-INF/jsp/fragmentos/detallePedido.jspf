<%@ page pageEncoding="UTF-8" %>
<%--
  Tabla de ítems y modificaciones de un pedido, con subtotales y total.
  Se incluye en pendientes.jsp y pedidoDetalle.jsp.
  Requiere una variable "pedido" (PedidoDetalleDTO) disponible en la página.
--%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<table>
    <thead>
        <tr>
            <th>Producto</th>
            <th>Cantidad</th>
            <th>Precio unitario</th>
            <th>Modificaciones (total a preparar)</th>
            <th>Subtotal</th>
        </tr>
    </thead>
    <tbody>
        <c:forEach var="item" items="${pedido.items}">
            <tr>
                <td data-label="Producto"><c:out value="${item.descripcionProducto}"/></td>
                <td data-label="Cantidad"><c:out value="${item.cantidad}"/></td>
                <td data-label="Precio unitario">$<fmt:formatNumber value="${item.precioVenta}" pattern="#,##0.00"/></td>
                <td data-label="Modificaciones">
                    <%-- Un solo bloque, para que en el celular quede a la derecha del título --%>
                    <div>
                        <c:choose>
                            <c:when test="${empty item.modificaciones}">Sin modificaciones</c:when>
                            <c:otherwise>
                                <c:forEach var="modif" items="${item.modificaciones}">
                                    ${modif.tipo == 'AGREGADO' ? '+' : '-'}
                                    <c:out value="${modif.descripcionIngrediente}"/>
                                    x<c:out value="${modif.cantidadTotal}"/><br>
                                </c:forEach>
                            </c:otherwise>
                        </c:choose>
                    </div>
                </td>
                <td data-label="Subtotal">$<fmt:formatNumber value="${item.subtotal}" pattern="#,##0.00"/></td>
            </tr>
        </c:forEach>
    </tbody>
    <tfoot>
        <tr>
            <th colspan="4">Total</th>
            <th>$<fmt:formatNumber value="${pedido.total}" pattern="#,##0.00"/></th>
        </tr>
    </tfoot>
</table>