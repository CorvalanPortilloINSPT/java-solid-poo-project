  <diagram id="pag2" name="2. Capas (controller, service, repository)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="p2_0" />
        <mxCell id="p2_1" parent="p2_0" />
        <mxCell id="titulo2" value="&lt;b style='font-size:18px'&gt;FastFood · backend · packages controller, service y repository&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#444444'&gt;Cada controller delega en su service, y cada service usa repositorios (inyección de dependencias por constructor). Las flechas punteadas salen de los parámetros de cada constructor. Los repositorios son interfaces: Spring Data JPA escribe la implementación. GeneradorId es una clase utilitaria (métodos estáticos) que usan todos los services.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="p2_1">
          <mxGeometry x="40" y="15" width="2093" height="85" as="geometry" />
        </mxCell>
