  <diagram id="pag3" name="3. Excepciones, seguridad y config">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="p3_0" />
        <mxCell id="p3_1" parent="p3_0" />
        <mxCell id="titulo3" value="&lt;b style='font-size:18px'&gt;FastFood · backend · packages exception, security y config&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#444444'&gt;Las excepciones de negocio heredan de NegocioException (abstracta, unchecked). GlobalExceptionHandler convierte cada una en una respuesta HTTP: 404, 400, 409 y 403. Seguridad: EmpleadoUserDetailsService autentica contra la base y SecurityConfig define los permisos por URL y el codificador de contraseñas: solo BCrypt (no se acepta ninguna contraseña en texto plano).&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="p3_1">
          <mxGeometry x="40" y="15" width="3318" height="85" as="geometry" />
