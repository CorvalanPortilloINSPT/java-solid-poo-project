        <mxCell id="p3_1" parent="p3_0" />
        <mxCell id="titulo3" value="&lt;b style='font-size:18px'&gt;FastFood · backend · packages exception, security y config&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#444444'&gt;Las excepciones de negocio heredan de NegocioException (abstracta, unchecked). GlobalExceptionHandler convierte cada una en una respuesta HTTP: 404, 400, 409 y 403. Seguridad: EmpleadoUserDetailsService autentica contra la base y SecurityConfig define los permisos por URL y el codificador de contraseñas (BCrypt + TextoPlanoLegacyEncoder).&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=0;" vertex="1" parent="p3_1">
          <mxGeometry x="40" y="15" width="3318" height="85" as="geometry" />
